# ================= 支付配置示例 =================
# 复制为 .env 并按需填写。本地演示可不填任何事项，默认以 sandbox 模式运行，
# 提交订单即自动到账，方便体验完整流程。

# 支付模式：sandbox（演示） | live（真实收款）
PAY_MODE=sandbox

# 美元/人民币汇率（Stripe 美元收款换算展示用）
USD_CNY_RATE=7.1

# 站点对外根地址：Stripe 支付回跳 + SEO canonical/sitemap/robots 依据。
# Render 免费部署后填你的二级域名，如 https://forum-xxxx.onrender.com；自购服务器则填 https://你的域名
BASE_URL=http://localhost:3000

# ============ Stripe（美元收款，海外/美元账户） ============
# 后台 Dashboard → Developers → API keys 获取；webhook 见 deploy.md
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============ 支付宝（中国大陆银行卡/花呗） ============
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ============ 微信支付（中国大陆银行卡/零钱） ============
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=